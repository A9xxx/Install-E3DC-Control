#!/bin/sh
set -eu

usage() {
    echo "Usage: $0 <install-path> <release-tag> <40-char-sha> <off|master|slave|shadow>" >&2
    exit 2
}

[ "$#" -eq 4 ] || usage

TARGET=$1
TAG=$2
EXPECTED_SHA=$3
EXPECTED_ROLE=$4
BOUND_PEER_IP=${E3DC_BOOTSTRAP_BOUND_PEER_IP:-}
ENTRY_MODE=${E3DC_BOOTSTRAP_ENTRY_MODE:-rescue}
CONFIRM_LOCAL_DRIFT=${E3DC_UPDATE_CONFIRM_LOCAL_DRIFT:-0}

case "$ENTRY_MODE" in
    regular|rescue) ;;
    *) echo "Interner Update-Einstiegsmodus ist ungültig." >&2; exit 2 ;;
esac
case "$CONFIRM_LOCAL_DRIFT" in
    0|1) ;;
    *) echo "Interne Freigabe lokaler Inhaltsabweichungen ist ungültig." >&2; exit 2 ;;
esac
case "$TARGET" in
    /*) ;;
    *) echo "Installationspfad muss absolut sein." >&2; exit 2 ;;
esac

case "$EXPECTED_ROLE" in
    off|master|slave|shadow) ;;
    *) echo "Ungueltige HA-/Shadow-Rolle." >&2; exit 2 ;;
esac

[ "${#EXPECTED_SHA}" -eq 40 ] || {
    echo "Ziel-SHA muss genau 40 Zeichen lang sein." >&2
    exit 2
}
case "$EXPECTED_SHA" in
    *[!0-9a-fA-F]*) echo "Ziel-SHA ist nicht hexadezimal." >&2; exit 2 ;;
esac

PYTHON=${PYTHON:-python3}
"$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' || {
    echo "[FEHLER] E3DC-UPD-PLATFORM-001: Dieser Release-Updater benötigt Python 3.10 oder neuer." >&2
    echo "[ZUSTAND] Die Installation und ihre Dienste wurden nicht verändert." >&2
    echo "[LÖSUNG] Prüfe 'python3 --version'. Aktualisiere das Raspberry-Pi-/Debian-System auf eine unterstützte Version mit Python 3.10 oder neuer und starte danach denselben Updatebefehl erneut." >&2
    exit 1
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
[ -f "$SCRIPT_DIR/Installer/update_simple.py" ] || {
    echo "Der einfache Ziel-Updater fehlt im Release-Archiv." >&2
    exit 1
}
[ "${E3DC_RELEASE_CHECKOUT_VERIFIED:-}" = "1" ] || {
    echo "Der Ziel-Updater wurde nicht aus dem bestätigten privaten Release-Checkout gestartet." >&2
    exit 1
}
"$PYTHON" - "$SCRIPT_DIR/VERSION" "$TAG" <<'PY' || {
from pathlib import Path
import sys

version_path = Path(sys.argv[1])
tag = sys.argv[2]
try:
    version = version_path.read_text(encoding="utf-8").strip()
except OSError:
    raise SystemExit(1)
raise SystemExit(0 if version and f"v{version}" == tag else 1)
PY
    echo "VERSION und gebundener Release-Tag widersprechen sich." >&2
    exit 1
}

if [ "$(id -u)" -eq 0 ]; then
    INSTALL_USER=${E3DC_BOOTSTRAP_USER:-${SUDO_USER:-}}
else
    INSTALL_USER=$(id -un)
fi
case "$INSTALL_USER" in
    ""|root|www-data)
        echo "Ein normaler Installationsbenutzer ist nicht eindeutig gebunden." >&2
        exit 2
        ;;
esac
"$PYTHON" - "$INSTALL_USER" <<'PY' || {
import sys

value = sys.argv[1]
valid = bool(
    value
    and value == value.strip()
    and "/" not in value
    and "\\" not in value
    and all(character.isalnum() or character in {"_", "-", "."} for character in value)
)
raise SystemExit(0 if valid else 1)
PY
    echo "Ein normaler Installationsbenutzer ist nicht eindeutig gebunden." >&2
    exit 2
}
id -u "$INSTALL_USER" >/dev/null 2>&1 || {
    echo "Der gebundene Installationsbenutzer existiert nicht." >&2
    exit 2
}

if [ "$(id -u)" -eq 0 ]; then
    exec env \
        E3DC_BOOTSTRAP_ROOT="$TARGET" \
        E3DC_BOOTSTRAP_RUNNER_ROOT="$SCRIPT_DIR" \
        E3DC_BOOTSTRAP_USER="$INSTALL_USER" \
        E3DC_BOOTSTRAP_ENTRY_MODE="$ENTRY_MODE" \
        E3DC_UPDATE_CONFIRM_LOCAL_DRIFT="$CONFIRM_LOCAL_DRIFT" \
        "$PYTHON" -I -B "$SCRIPT_DIR/Installer/update_simple.py" \
        --target "$TARGET" \
        --install-user "$INSTALL_USER" \
        --tag "$TAG" \
        --role "$EXPECTED_ROLE" \
        --peer-ip "$BOUND_PEER_IP"
fi

exec sudo -- env \
    E3DC_BOOTSTRAP_ROOT="$TARGET" \
    E3DC_BOOTSTRAP_RUNNER_ROOT="$SCRIPT_DIR" \
    E3DC_BOOTSTRAP_USER="$INSTALL_USER" \
    E3DC_BOOTSTRAP_ENTRY_MODE="$ENTRY_MODE" \
    E3DC_UPDATE_CONFIRM_LOCAL_DRIFT="$CONFIRM_LOCAL_DRIFT" \
    "$PYTHON" -I -B "$SCRIPT_DIR/Installer/update_simple.py" \
    --target "$TARGET" \
    --install-user "$INSTALL_USER" \
    --tag "$TAG" \
    --role "$EXPECTED_ROLE" \
    --peer-ip "$BOUND_PEER_IP"
