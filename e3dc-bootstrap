#!/bin/sh
set -eu

usage() {
    echo "Usage: $0 <install-path> <release-tag> <40-char-sha> <off|master|slave|shadow>" >&2
    exit 2
}

[ "$#" -eq 4 ] || usage

TARGET=$1
TAG=$2
EXPECTED_SHA=$3
EXPECTED_ROLE=$4
ENTRY_MODE=${E3DC_BOOTSTRAP_ENTRY_MODE:-rescue}

case "$ENTRY_MODE" in
    regular|rescue) ;;
    *) echo "Interner Update-Einstiegsmodus ist ungültig." >&2; exit 2 ;;
esac

case "$TARGET" in
    /*) ;;
    *) echo "Installationspfad muss absolut sein." >&2; exit 2 ;;
esac

case "$EXPECTED_ROLE" in
    off|master|slave|shadow) ;;
    *) echo "Ungueltige HA-/Shadow-Rolle." >&2; exit 2 ;;
esac

[ "${#EXPECTED_SHA}" -eq 40 ] || {
    echo "Ziel-SHA muss genau 40 Zeichen lang sein." >&2
    exit 2
}
case "$EXPECTED_SHA" in
    *[!0-9a-fA-F]*) echo "Ziel-SHA ist nicht hexadezimal." >&2; exit 2 ;;
esac

PYTHON=${PYTHON:-python3}
"$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' || {
    echo "Dieser Release-Installer benoetigt Python 3.10 oder neuer; es wurde noch nichts veraendert." >&2
    exit 1
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
[ -f "$SCRIPT_DIR/installer_main.py" ] || {
    echo "installer_main.py fehlt im Release-Archiv." >&2
    exit 1
}

if [ "$(id -u)" -eq 0 ]; then
    INSTALL_USER=${E3DC_BOOTSTRAP_USER:-${SUDO_USER:-}}
else
    INSTALL_USER=$(id -un)
fi
case "$INSTALL_USER" in
    ""|root|www-data)
        echo "Ein normaler Installationsbenutzer ist nicht eindeutig gebunden." >&2
        exit 2
        ;;
esac
"$PYTHON" - "$INSTALL_USER" <<'PY' || {
import sys

value = sys.argv[1]
valid = bool(
    value
    and value == value.strip()
    and "/" not in value
    and "\\" not in value
    and all(character.isalnum() or character in {"_", "-", "."} for character in value)
)
raise SystemExit(0 if valid else 1)
PY
    echo "Ein normaler Installationsbenutzer ist nicht eindeutig gebunden." >&2
    exit 2
}
id -u "$INSTALL_USER" >/dev/null 2>&1 || {
    echo "Der gebundene Installationsbenutzer existiert nicht." >&2
    exit 2
}

if [ "$(id -u)" -eq 0 ]; then
    exec env \
        E3DC_BOOTSTRAP_ROOT="$TARGET" \
        E3DC_BOOTSTRAP_RUNNER_ROOT="$SCRIPT_DIR" \
        E3DC_BOOTSTRAP_USER="$INSTALL_USER" \
        E3DC_BOOTSTRAP_ENTRY_MODE="$ENTRY_MODE" \
        "$PYTHON" "$SCRIPT_DIR/installer_main.py" \
        --unattended \
        --install-release-tag "$TAG" \
        --bootstrap-install-path "$TARGET" \
        --expected-release-sha "$EXPECTED_SHA" \
        --expected-ha-role "$EXPECTED_ROLE"
fi

exec sudo -- env \
    E3DC_BOOTSTRAP_ROOT="$TARGET" \
    E3DC_BOOTSTRAP_RUNNER_ROOT="$SCRIPT_DIR" \
    E3DC_BOOTSTRAP_USER="$INSTALL_USER" \
    E3DC_BOOTSTRAP_ENTRY_MODE="$ENTRY_MODE" \
    "$PYTHON" "$SCRIPT_DIR/installer_main.py" \
    --unattended \
    --install-release-tag "$TAG" \
    --bootstrap-install-path "$TARGET" \
    --expected-release-sha "$EXPECTED_SHA" \
    --expected-ha-role "$EXPECTED_ROLE"
