#!/usr/bin/env bash
# Portabler lokaler Einstieg für Setup und Reparatur.

set -euo pipefail

SOURCE=$BASH_SOURCE
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)
    LINK_TARGET=$(readlink -- "$SOURCE")
    if [[ "$LINK_TARGET" = /* ]]; then
        SOURCE=$LINK_TARGET
    else
        SOURCE=$SOURCE_DIR/$LINK_TARGET
    fi
done
SCRIPT_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)

if [[ ! -f "$SCRIPT_DIR/VERSION" ||
      ! -f "$SCRIPT_DIR/installer_main.py" ||
      ! -f "$SCRIPT_DIR/Installer/installer_config.py" ]]; then
    echo "Setup abgebrochen: Der lokale Produkt-Root ist nicht eindeutig." >&2
    exit 2
fi

if [[ -f /.dockerenv && "$SCRIPT_DIR" != "/app/pi/Install" ]]; then
    echo "Setup abgebrochen: Der Container-Root entspricht nicht dem Image-Vertrag." >&2
    exit 2
fi

# Der lokale Setup-Einstieg ist kein Release-Bootstrap. Fremde oder nur
# teilweise gesetzte Bootstrap-Bindungen dürfen deshalb nicht in den
# normalen Installationskontext hineinreichen.
unset E3DC_BOOTSTRAP_ROOT E3DC_BOOTSTRAP_RUNNER_ROOT

if [[ $EUID -ne 0 ]]; then
    CALLING_USER=$(id -un)
    if [[ -z "$CALLING_USER" || "$CALLING_USER" = "www-data" ]]; then
        echo "Setup abgebrochen: Das lokale Installationskonto ist nicht bestätigt." >&2
        exit 2
    fi
    exec sudo env \
        "E3DC_BOOTSTRAP_USER=$CALLING_USER" \
        "$SCRIPT_DIR/e3dc-setup" "$@"
fi

if [[ -f /.dockerenv ]]; then
    SYSTEM_PYTHON=/opt/venv/bin/python3
else
    SYSTEM_PYTHON=/usr/bin/python3
fi
if [[ ! -x "$SYSTEM_PYTHON" ]]; then
    echo "Setup abgebrochen: Kein freigegebener Bootstrap-Interpreter vorhanden." >&2
    exit 2
fi

RELEASE_ENTRY=0
if [[ $# -eq 0 ]]; then
    # Das interaktive Menü enthält den produktiven Updatepunkt und startet
    # deshalb ebenfalls ohne benutzerbeschreibbares venv.
    RELEASE_ENTRY=1
else
    for argument in "$@"; do
        case "$argument" in
            --update-e3dc|--reinstall-current|--install-release-tag)
                RELEASE_ENTRY=1
                ;;
        esac
    done
fi

PYTHON_FLAGS=()
if [[ $RELEASE_ENTRY -eq 1 ]]; then
    if [[ ! -f /.dockerenv ]]; then
        RESOLVED_SYSTEM_PYTHON=$(readlink -f -- "$SYSTEM_PYTHON")
        if [[ ! "$RESOLVED_SYSTEM_PYTHON" =~ ^/usr/bin/python3([.][0-9]+)*$ ]] \
            || [[ ! -x "$RESOLVED_SYSTEM_PYTHON" ]]; then
            echo "Setup abgebrochen: System-Python besitzt kein freigegebenes Ziel." >&2
            exit 2
        fi
        read -r PY_OWNER PY_MODE < <(stat -Lc '%u %a' -- "$RESOLVED_SYSTEM_PYTHON")
        read -r PY_PARENT_OWNER PY_PARENT_MODE < <(stat -Lc '%u %a' -- /usr/bin)
        if [[ "$PY_OWNER" != "0" || "$PY_PARENT_OWNER" != "0" ]] \
            || (( (8#$PY_MODE & 0022) != 0 )) \
            || (( (8#$PY_PARENT_MODE & 0022) != 0 )); then
            echo "Setup abgebrochen: System-Python ist nicht root-kontrolliert." >&2
            exit 2
        fi
        PYTHON_EXEC=$RESOLVED_SYSTEM_PYTHON
    else
        PYTHON_EXEC=$SYSTEM_PYTHON
    fi
    PYTHON_FLAGS=(-I -B -u)
else
    PYTHON_EXEC=$(
        cd -- "$SCRIPT_DIR"
        "$SYSTEM_PYTHON" -I -B -u - "$SCRIPT_DIR" <<'PY'
import os
import sys

root = os.path.realpath(sys.argv[1])
sys.path.insert(0, root)
from Installer.transition_context import get_transition_context

context = get_transition_context(
    explicit_install_path=root,
    explicit_install_user=os.environ.get("E3DC_BOOTSTRAP_USER") or None,
    require_trusted=True,
)
candidate = context.venv_python
if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
    print(candidate)
else:
    print(sys.executable)
PY
    )
fi

if [[ -z "$PYTHON_EXEC" || ! -x "$PYTHON_EXEC" ]]; then
    echo "Setup abgebrochen: Der Installationsinterpreter ist nicht validierbar." >&2
    exit 2
fi

cd -- "$SCRIPT_DIR"
exec "$PYTHON_EXEC" "${PYTHON_FLAGS[@]}" "$SCRIPT_DIR/installer_main.py" "$@"
