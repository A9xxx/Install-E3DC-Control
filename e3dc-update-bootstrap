#!/bin/sh
# Unabhängiger Community-Einstieg für ein E3DC-Control Rettungsupdate.
#
# Das Skript nimmt ausschließlich den Auftrag an, bindet den aktuellen
# veröffentlichten Release und übergibt Installation, Benutzer und Rolle an
# dessen zentrale Discovery. Backup, Diensteruhe, Projektion, Rechte sowie
# Start- und Healthprüfung bleiben allein Aufgabe des Ziel-Updaters.

set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

REPOSITORY_URL="https://github.com/A9xxx/Install-E3DC-Control"
GIT_URL="${REPOSITORY_URL}.git"
LATEST_URL="${REPOSITORY_URL}/releases/latest"
RAW_RELEASE_URL="https://raw.githubusercontent.com/A9xxx/Install-E3DC-Control"
UNIT="e3dc-web-update.service"
RUNTIME_DIR="/run/e3dc-web-update"
LOG_DIR="/var/log/e3dc-control"
LOG_FILE="${LOG_DIR}/web-update.log"
PID_FILE="${RUNTIME_DIR}/pid"
STATUS_FILE="${RUNTIME_DIR}/status"
LOCK_FILE="${RUNTIME_DIR}/lock"
START_LOCK_FILE="${RUNTIME_DIR}/start.lock"
DISCOVERY_RELATIVE="Installer/update_bootstrap_discovery.py"
LEGACY_REGULAR_PARENT=""
PREVALIDATED_REGULAR_RELEASE=0

fail_with_solution() {
    code=$1
    happened=$2
    system_state=$3
    target=$4
    solution=$5
    exit_code=${6:-1}
    printf '\n[ABBRUCH] %s\n' "$code" >&2
    printf 'Was ist passiert: %s\n' "$happened" >&2
    printf 'Systemzustand: %s\n' "$system_state" >&2
    printf 'Ziel: %s\n' "$target" >&2
    printf 'Lösung: Führe genau diesen sicheren Befehl aus:\n  %s\n' "$solution" >&2
    exit "$exit_code"
}

fail() {
    if [ "$*" = "Rettungsupdate bitte mit sudo starten" ]; then
        fail_with_solution \
            "E3DC-UPD-PRIV-001" \
            "Der Update-Bootstrap wurde ohne root-Rechte gestartet; bitte mit sudo starten." \
            "Es wurden noch keine Updatedateien geladen und keine Dienste verändert." \
            "Lokaler Update-Bootstrap" \
            "sudo /bin/sh ./e3dc-update-bootstrap" \
            77
    fi
    fail_with_solution \
        "E3DC-UPD-BOOT-999" \
        "$*" \
        "Der zuletzt vollständig bestätigte Zustand bleibt maßgeblich; ein erfolgreicher Abschluss wurde nicht gemeldet." \
        "E3DC-Control Update" \
        "sudo journalctl -u $UNIT --no-pager -n 120"
}

dependency_package() {
    case "$1" in
        awk) printf '%s\n' gawk ;;
        curl) printf '%s\n' curl ;;
        find) printf '%s\n' findutils ;;
        flock) printf '%s\n' util-linux ;;
        getent) printf '%s\n' libc-bin ;;
        git) printf '%s\n' git ;;
        journalctl|systemctl|systemd-run) printf '%s\n' systemd ;;
        basename|cat|chmod|chown|date|dirname|env|id|install|mkdir|mktemp|mv|rm|stat|unlink)
            printf '%s\n' coreutils
            ;;
        python3) printf '%s\n' python3 ;;
        *) printf '%s\n' "$1" ;;
    esac
}

require_commands() {
    for command in \
        awk curl basename cat chmod chown date dirname env find flock getent git id \
        install journalctl mkdir mktemp mv python3 rm stat systemctl systemd-run unlink
    do
        if ! command -v "$command" >/dev/null 2>&1; then
            package=$(dependency_package "$command")
            fail_with_solution \
                "E3DC-UPD-DEP-001" \
                "Das benötigte Programm '$command' fehlt." \
                "Das Update wurde vor Download, Backup und Dienständerungen beendet." \
                "Systempaket $package" \
                "sudo apt-get install -y $package"
        fi
    done
}

write_runtime_value() {
    target=$1
    value=$2
    temporary=$(mktemp "${RUNTIME_DIR}/.$(basename "$target").XXXXXX") \
        || fail_with_solution \
            "E3DC-UPD-RUN-003" \
            "Die temporäre Statusdatei konnte nicht im privaten Laufzeitverzeichnis angelegt werden." \
            "Der bisherige Status blieb unverändert; der neue Wert wurde nicht veröffentlicht." \
            "$target" \
            "sudo stat -c '%U %G %a %F %n' $RUNTIME_DIR"
    if ! printf '%s\n' "$value" >"$temporary"; then
        fail_with_solution \
            "E3DC-UPD-FS-201" \
            "Der neue Laufzeitstatus konnte nicht geschrieben werden." \
            "Die Zieldatei wurde nicht ersetzt." \
            "$target" \
            "sudo stat -c '%U %G %a %F %n' $temporary $RUNTIME_DIR"
    fi
    chown root:www-data "$temporary" \
        || fail_with_solution \
            "E3DC-UPD-FS-202" \
            "Der Besitzer der neuen Laufzeitstatusdatei konnte nicht gesetzt werden." \
            "Die Zieldatei wurde nicht ersetzt." \
            "$target" \
            "sudo stat -c '%U %G %a %F %n' $temporary"
    chmod 0640 "$temporary" \
        || fail_with_solution \
            "E3DC-UPD-FS-203" \
            "Die Rechte der neuen Laufzeitstatusdatei konnten nicht gesetzt werden." \
            "Die Zieldatei wurde nicht ersetzt." \
            "$target" \
            "sudo stat -c '%U %G %a %F %n' $temporary"
    mv -fT "$temporary" "$target" \
        || fail_with_solution \
            "E3DC-UPD-FS-204" \
            "Der vollständig vorbereitete Laufzeitstatus konnte nicht atomar veröffentlicht werden." \
            "Die bisherige Zieldatei blieb maßgeblich." \
            "$target" \
            "sudo stat -c '%U %G %a %F %n' $target $RUNTIME_DIR"
}

prepare_job_paths() {
    getent group www-data >/dev/null 2>&1 \
        || fail_with_solution \
            "E3DC-UPD-DEP-002" \
            "Die für Webstatus und Protokoll benötigte Gruppe www-data fehlt." \
            "Der Ziel-Updater wurde nicht gestartet; Installation und Dienste wurden durch diesen Schritt nicht verändert." \
            "Systemgruppe www-data" \
            "sudo apt-get install -y apache2"
    for parent in /run /var/log; do
        [ ! -L "$parent" ] || fail "System-Elternpfad ist ein Symlink: $parent"
        metadata=$(stat -c '%u %F' "$parent") \
            || fail "System-Elternpfad ist nicht prüfbar: $parent"
        [ "$metadata" = "0 directory" ] \
            || fail "System-Elternpfad ist nicht root-kontrolliert: $parent"
    done
    for path in "$RUNTIME_DIR" "$LOG_DIR"; do
        [ ! -L "$path" ] || fail "Runtime- oder Logpfad ist ein Symlink: $path"
        if [ -e "$path" ] && [ ! -d "$path" ]; then
            fail "Runtime- oder Logpfad ist kein Verzeichnis: $path"
        fi
    done
    install -d -o root -g www-data -m 0750 "$RUNTIME_DIR" \
        || fail_with_solution \
            "E3DC-UPD-RUN-001" \
            "Das private Laufzeitverzeichnis konnte nicht angelegt oder bestätigt werden." \
            "Der Ziel-Updater wurde nicht gestartet; Installation und Dienste wurden durch diesen Schritt nicht verändert." \
            "$RUNTIME_DIR" \
            "sudo stat -c '%U %G %a %F %n' /run"
    install -d -o root -g root -m 0755 "$LOG_DIR" \
        || fail_with_solution \
            "E3DC-UPD-RUN-002" \
            "Das Update-Protokollverzeichnis konnte nicht angelegt oder bestätigt werden." \
            "Der Ziel-Updater wurde nicht gestartet; Installation und Dienste wurden durch diesen Schritt nicht verändert." \
            "$LOG_DIR" \
            "sudo stat -c '%U %G %a %F %n' /var/log"
    if [ -L "$LOG_FILE" ]; then
        fail "Updateprotokoll ist ein Symlink"
    fi
    if [ ! -e "$LOG_FILE" ]; then
        (set -C; : >"$LOG_FILE") 2>/dev/null || true
    fi
    metadata=$(stat -c '%F %h' "$LOG_FILE") || fail "Updateprotokoll ist nicht prüfbar"
    case "$metadata" in
        "regular file 1"|"regular empty file 1") ;;
        *) fail "Updateprotokoll besitzt einen unzulässigen Pfadtyp" ;;
    esac
    chown root:www-data "$LOG_FILE" \
        || fail_with_solution \
            "E3DC-UPD-FS-205" \
            "Der Besitzer des Updateprotokolls konnte nicht gesetzt werden." \
            "Der Ziel-Updater wurde nicht gestartet; Installation und Dienste wurden durch diesen Schritt nicht verändert." \
            "$LOG_FILE" \
            "sudo stat -c '%U %G %a %F %n' $LOG_FILE"
    chmod 0640 "$LOG_FILE" \
        || fail_with_solution \
            "E3DC-UPD-FS-206" \
            "Die geschützten Rechte des Updateprotokolls konnten nicht gesetzt werden." \
            "Der Ziel-Updater wurde nicht gestartet; Installation und Dienste wurden durch diesen Schritt nicht verändert." \
            "$LOG_FILE" \
            "sudo stat -c '%U %G %a %F %n' $LOG_FILE"
}

prepare_lock_file() {
    lock_path=$1
    if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
        if [ -L "$lock_path" ]; then
            unlink "$lock_path"
        else
            metadata=$(stat -c '%u %g %F %h' "$lock_path") \
                || fail "Update-Lock ist nicht prüfbar"
            case "$metadata" in
                "0 0 regular file 1"|"0 0 regular empty file 1") ;;
                *) unlink "$lock_path" || fail "Unsicherer Update-Lock konnte nicht ersetzt werden" ;;
            esac
        fi
    fi
    if [ ! -e "$lock_path" ]; then
        (set -C; : >"$lock_path") 2>/dev/null || true
    fi
    metadata=$(stat -c '%u %g %F %h' "$lock_path") \
        || fail "Update-Lock konnte nicht atomar angelegt werden"
    case "$metadata" in
        "0 0 regular file 1"|"0 0 regular empty file 1") ;;
        *) fail "Update-Lock besitzt nach Anlage unzulässige Metadaten" ;;
    esac
    chown root:root "$lock_path" \
        || fail_with_solution \
            "E3DC-UPD-FS-207" \
            "Der Besitzer der privaten Update-Sperre konnte nicht gesetzt werden." \
            "Es wurde kein neuer Updateauftrag unter dieser Sperre angenommen." \
            "$lock_path" \
            "sudo stat -c '%U %G %a %F %n' $lock_path"
    chmod 0600 "$lock_path" \
        || fail_with_solution \
            "E3DC-UPD-FS-208" \
            "Die privaten Rechte der Update-Sperre konnten nicht gesetzt werden." \
            "Es wurde kein neuer Updateauftrag unter dieser Sperre angenommen." \
            "$lock_path" \
            "sudo stat -c '%U %G %a %F %n' $lock_path"
}

prepare_log() {
    : >"$LOG_FILE" \
        || fail_with_solution \
            "E3DC-UPD-FS-209" \
            "Das Updateprotokoll konnte nicht für den neuen Auftrag geöffnet werden." \
            "Der eigentliche Updatevorgang wurde noch nicht gestartet." \
            "$LOG_FILE" \
            "sudo stat -c '%U %G %a %s %F %n' $LOG_FILE"
    printf '=== E3DC-Control Rettungsupdate %s ===\n' "$(date --iso-8601=seconds)" >>"$LOG_FILE" \
        || fail_with_solution \
            "E3DC-UPD-FS-210" \
            "Der Kopf des Updateprotokolls konnte nicht geschrieben werden." \
            "Der eigentliche Updatevorgang wurde noch nicht gestartet." \
            "$LOG_FILE" \
            "sudo stat -c '%U %G %a %s %F %n' $LOG_FILE"
}

isolated_git() {
    env -i \
        PATH=/usr/bin:/bin \
        HOME=/nonexistent \
        XDG_CONFIG_HOME=/nonexistent \
        LANG=C \
        LC_ALL=C \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_SYSTEM=/dev/null \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_ATTR_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 \
        GIT_TERMINAL_PROMPT=0 \
        GIT_ASKPASS=/bin/false \
        SSH_ASKPASS=/bin/false \
        GIT_ALLOW_PROTOCOL=https \
        /usr/bin/git \
        --no-replace-objects \
        -c credential.helper= \
        -c core.askPass=/bin/false \
        -c protocol.ext.allow=never \
        -c protocol.file.allow=never \
        "$@"
}

resolve_release_tag() {
    if [ "$BOUND_ENTRY_MODE" = "regular" ]; then
        tag=${E3DC_BOOTSTRAP_EXPECTED_TAG:-}
        [ -n "$tag" ] || fail "Regular-Modus besitzt keinen gebundenen Release-Tag"
    else
        effective_latest=$(curl -q \
            --fail --silent --show-error --location \
            --proto '=https' --tlsv1.2 \
            --output /dev/null --write-out '%{url_effective}' \
            "$LATEST_URL") \
            || fail_with_solution \
                "E3DC-UPD-NET-001" \
                "Der aktuelle veröffentlichte Release konnte nicht über HTTPS ermittelt werden." \
                "Es wurde noch kein Release heruntergeladen; Installation und Dienste blieben unverändert." \
                "$LATEST_URL" \
                "curl -I --proto '=https' --tlsv1.2 $LATEST_URL"
        case "$effective_latest" in
            "$REPOSITORY_URL/releases/tag/"*) tag=${effective_latest##*/} ;;
            *) fail "GitHub lieferte keinen eindeutigen aktuellen Release-Tag" ;;
        esac
    fi
    python3 - "$tag" <<'PY' || fail "Release-Tag besitzt ein unerwartetes Format: $tag"
import re
import sys
raise SystemExit(0 if re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+[a-z]?", sys.argv[1]) else 1)
PY
    printf '%s\n' "$tag"
}

bind_entry_mode() {
    requested=${E3DC_BOOTSTRAP_ENTRY_MODE:-rescue}
    case "$requested" in
        rescue)
            BOUND_ENTRY_MODE=rescue
            ;;
        regular)
            [ -n "${E3DC_BOOTSTRAP_EXPECTED_TAG:-}" ] \
                && [ -n "${E3DC_BOOTSTRAP_EXPECTED_TAG_OBJECT:-}" ] \
                && [ -n "${E3DC_BOOTSTRAP_EXPECTED_SHA:-}" ] \
                || fail "Regular-Modus besitzt keine vollständige Tag-/SHA-Bindung"
            [ "${#E3DC_BOOTSTRAP_EXPECTED_TAG_OBJECT}" -eq 40 ] \
                && [ "${#E3DC_BOOTSTRAP_EXPECTED_SHA}" -eq 40 ] \
                || fail "Regular-Modus besitzt keine vollständige Release-SHA-Bindung"
            case "$E3DC_BOOTSTRAP_EXPECTED_TAG_OBJECT:$E3DC_BOOTSTRAP_EXPECTED_SHA" in
                *[!0-9a-f:]*) fail "Regular-Modus besitzt ungültige Release-SHAs" ;;
            esac
            BOUND_ENTRY_MODE=regular
            if [ -n "${E3DC_BOOTSTRAP_RELEASE_DIR:-}" ]; then
                validate_release_checkout \
                    "$E3DC_BOOTSTRAP_RELEASE_DIR" \
                    "$E3DC_BOOTSTRAP_EXPECTED_TAG" \
                    "$E3DC_BOOTSTRAP_EXPECTED_TAG_OBJECT" \
                    "$E3DC_BOOTSTRAP_EXPECTED_SHA"
                PREVALIDATED_REGULAR_RELEASE=1
            else
                LEGACY_REGULAR_PARENT=$(legacy_regular_bootstrap_parent)
            fi
            # Alte Web-Launcher halten den äußeren Update-Lock bereits, benennen
            # ihn aber nicht in jeder veröffentlichten Generation gleich. Nach
            # der privaten Pfad-/Releaseprüfung ist kein weiterer Parent-Guard
            # nötig; der Ziel-Updater besitzt zusätzlich seinen eigenen Lock.
            E3DC_BOOTSTRAP_LOCK_HELD=1
            ;;
        *) fail "Update-Einstiegsmodus muss regular oder rescue sein" ;;
    esac
}

validate_private_file() {
    path=$1
    expected_mode=$2
    metadata=$(stat -c '%u %g %a %F %h' "$path") \
        || fail "Root-private Updatedatei ist nicht prüfbar: $path"
    [ "$metadata" = "0 0 $expected_mode regular file 1" ] \
        || fail "Root-private Updatedatei besitzt unzulässige Metadaten: $path"
}

legacy_regular_bootstrap_parent() {
    bootstrap_path=$0
    case "$bootstrap_path" in
        /run/e3dc-update-download.*/e3dc-update-bootstrap) ;;
        *) fail "Legacy-Regular-Bootstrap liegt nicht im privaten Downloadpfad" ;;
    esac
    parent=${bootstrap_path%/e3dc-update-bootstrap}
    suffix=${parent#/run/e3dc-update-download.}
    case "$suffix" in
        ""|*/*) fail "Legacy-Regular-Bootstrap besitzt keinen eindeutigen Elternpfad" ;;
    esac
    [ ! -L "$parent" ] && [ ! -L "$bootstrap_path" ] \
        || fail "Legacy-Regular-Bootstrap darf kein Symlink sein"
    parent_metadata=$(stat -c '%u %g %a %F' "$parent") \
        || fail "Privater Legacy-Downloadpfad ist nicht prüfbar"
    [ "$parent_metadata" = "0 0 700 directory" ] \
        || fail "Privater Legacy-Downloadpfad ist nicht ausschließlich root-zugänglich"
    validate_private_file "$bootstrap_path" 500
    printf '%s\n' "$parent"
}

stage_release_contract() {
    stage_dir=$(mktemp -d /run/e3dc-update-bootstrap.XXXXXX) \
        || fail_with_solution \
            "E3DC-UPD-RUN-005" \
            "Der private Arbeitsbereich für den neuen Updater konnte nicht angelegt werden." \
            "Es wurden weder Installationsdateien ersetzt noch Dienste verändert." \
            "/run/e3dc-update-bootstrap.*" \
            "sudo stat -c '%U %G %a %F %n' /run"
    chown root:root "$stage_dir" \
        || fail_with_solution \
            "E3DC-UPD-FS-211" \
            "Der private Arbeitsbereich konnte nicht root zugeordnet werden." \
            "Der Arbeitsbereich wird nicht als Updatequelle verwendet; Installation und Dienste blieben unverändert." \
            "$stage_dir" \
            "sudo stat -c '%U %G %a %F %n' $stage_dir"
    chmod 0700 "$stage_dir" \
        || fail_with_solution \
            "E3DC-UPD-FS-212" \
            "Der private Arbeitsbereich konnte nicht auf root beschränkt werden." \
            "Der Arbeitsbereich wird nicht als Updatequelle verwendet; Installation und Dienste blieben unverändert." \
            "$stage_dir" \
            "sudo stat -c '%U %G %a %F %n' $stage_dir"
    printf '%s\n' "$stage_dir"
}

cleanup_synchronous_stage() {
    cleanup_status=$?
    trap - EXIT
    set +e
    case "${STAGE_DIR:-}" in
        /run/e3dc-update-bootstrap.*)
            [ ! -d "$STAGE_DIR" ] || find "$STAGE_DIR" -depth -delete 2>/dev/null
            ;;
    esac
    exit "$cleanup_status"
}

bind_with_discovery() {
    discovery=$1
    explicit_root=$2
    explicit_user=$3
    sudo_user=$4
    requested_role=$5
    prefer_launcher_binding=${6:-0}
    if [ "$prefer_launcher_binding" = "1" ]; then
        python3 -I -B "$discovery" \
            --explicit-root "$explicit_root" \
            --explicit-user "$explicit_user" \
            --sudo-user "$sudo_user" \
            --requested-role "$requested_role" \
            --prefer-launcher-binding
    else
        python3 -I -B "$discovery" \
            --explicit-root "$explicit_root" \
            --explicit-user "$explicit_user" \
            --sudo-user "$sudo_user" \
            --requested-role "$requested_role"
    fi
}

list_with_discovery() {
    discovery=$1
    python3 -I -B "$discovery" --list-candidates
}

interactive_terminal() {
    [ -t 0 ] && [ -t 1 ]
}

shell_quote() {
    python3 - "$1" <<'PY'
import shlex
import sys
print(shlex.quote(sys.argv[1]))
PY
}

select_console_target() {
    discovery=$1
    requested_root=$2
    if [ -n "$requested_root" ]; then
        SELECTED_EXPLICIT_ROOT=$requested_root
        return 0
    fi

    candidates_file=$(mktemp "${STAGE_DIR}/candidates.XXXXXX") \
        || fail_with_solution \
            "E3DC-UPD-RUN-006" \
            "Die private Kandidatenliste für die Installationserkennung konnte nicht angelegt werden." \
            "Es wurde keine Installation ausgewählt und der eigentliche Updater nicht gestartet." \
            "$STAGE_DIR" \
            "sudo stat -c '%U %G %a %F %n' $STAGE_DIR"
    if ! list_with_discovery "$discovery" >"$candidates_file"; then
        find "$STAGE_DIR" -depth -delete 2>/dev/null || true
        fail_with_solution \
            "E3DC-UPD-PATH-009" \
            "Die lokale Installationserkennung konnte nicht ausgeführt werden." \
            "Es wurde keine Installation ausgewählt und der eigentliche Updater nicht gestartet." \
            "Lokale E3DC-Control-Installation" \
            "sudo journalctl -u $UNIT --no-pager -n 120"
    fi
    candidate_count=$(awk 'NF { count += 1 } END { print count + 0 }' "$candidates_file")
    if [ "$candidate_count" -eq 0 ]; then
        SELECTED_EXPLICIT_ROOT=""
        rm -f "$candidates_file"
        return 0
    fi
    if [ "$candidate_count" -eq 1 ]; then
        candidate_line=$(awk 'NF { print; exit }' "$candidates_file")
        SELECTED_EXPLICIT_ROOT=${candidate_line%%"$(printf '\t')"*}
        rm -f "$candidates_file"
        return 0
    fi

    if interactive_terminal; then
        printf '\nMehrere gleichrangige E3DC-Control-Instanzen wurden erkannt:\n'
        awk -F '\t' '{ printf "  %d) %s [%s]\n", NR, $1, $2 }' "$candidates_file"
        printf 'Bitte wähle die zu aktualisierende Instanz (1-%s): ' "$candidate_count"
        if ! IFS= read -r selection; then
            find "$STAGE_DIR" -depth -delete 2>/dev/null || true
            fail_with_solution \
                "E3DC-UPD-PATH-010" \
                "Die Instanzauswahl wurde ohne Eingabe beendet." \
                "Keine der erkannten Installationen wurde verändert." \
                "Lokale E3DC-Control-Instanz" \
                "sudo /bin/sh ./e3dc-update-bootstrap" \
                64
        fi
        case "$selection" in
            ''|*[!0-9]*|????*)
                find "$STAGE_DIR" -depth -delete 2>/dev/null || true
                fail_with_solution \
                    "E3DC-UPD-PATH-010" \
                    "Die Instanzauswahl ist keine gültige Nummer." \
                    "Keine der erkannten Installationen wurde verändert." \
                    "Lokale E3DC-Control-Instanz" \
                    "sudo /bin/sh ./e3dc-update-bootstrap" \
                    64
                ;;
        esac
        if [ "$selection" -lt 1 ] || [ "$selection" -gt "$candidate_count" ]; then
            find "$STAGE_DIR" -depth -delete 2>/dev/null || true
            fail_with_solution \
                "E3DC-UPD-PATH-010" \
                "Die Instanzauswahl liegt außerhalb der angezeigten Liste." \
                "Keine der erkannten Installationen wurde verändert." \
                "Lokale E3DC-Control-Instanz" \
                "sudo /bin/sh ./e3dc-update-bootstrap" \
                64
        fi
        candidate_line=$(awk -v number="$selection" 'NR == number { print; exit }' "$candidates_file")
        SELECTED_EXPLICIT_ROOT=${candidate_line%%"$(printf '\t')"*}
        rm -f "$candidates_file"
        return 0
    fi

    printf '\n[ABBRUCH] E3DC-UPD-PATH-005\n' >&2
    printf 'Was ist passiert: Mehrere gleichrangige E3DC-Control-Instanzen wurden erkannt; kein Pfad wurde geraten.\n' >&2
    printf 'Systemzustand: Keine der erkannten Installationen wurde verändert.\n' >&2
    printf 'Ziel: Eine vom Nutzer eindeutig ausgewählte E3DC-Control-Instanz.\n' >&2
    printf 'Lösung: Starte genau einen der folgenden Hintergrundbefehle:\n' >&2
    while IFS="$(printf '\t')" read -r candidate_root candidate_sources; do
        [ -n "$candidate_root" ] || continue
        quoted_root=$(shell_quote "$candidate_root")
        quoted_url=$(shell_quote "$RAW_RELEASE_URL/$BOUND_TAG/e3dc-update-bootstrap")
        printf '  bootstrap_file="$(mktemp)" && curl -q -fsS --proto =https --tlsv1.2 -o "$bootstrap_file" %s && sudo /bin/sh "$bootstrap_file" %s; rc=$?; rm -f -- "$bootstrap_file"; [ "$rc" -eq 0 ]  # %s\n' \
            "$quoted_url" "$quoted_root" "$candidate_sources" >&2
    done <"$candidates_file"
    find "$STAGE_DIR" -depth -delete 2>/dev/null || true
    exit 64
}

parse_binding() {
    binding=$1
    tab=$(printf '\t')
    case "$binding" in
        *"$tab"*"$tab"*"$tab"*) ;;
        *) fail "Discovery lieferte keine eindeutige Root-/Benutzer-/Rollen-/Peer-Bindung" ;;
    esac
    BOUND_ROOT=${binding%%"$tab"*}
    remainder=${binding#*"$tab"}
    BOUND_USER=${remainder%%"$tab"*}
    role_and_peer=${remainder#*"$tab"}
    BOUND_ROLE=${role_and_peer%%"$tab"*}
    BOUND_PEER_IP=${role_and_peer#*"$tab"}
    case "$BOUND_PEER_IP" in
        *"$tab"*) fail "Discovery lieferte überzählige Bindungsfelder" ;;
    esac
    [ -n "$BOUND_ROOT" ] && [ -n "$BOUND_USER" ] \
        || fail "Discovery-Bindung blieb unvollständig"
    case "$BOUND_ROLE" in
        off|master|slave|shadow) ;;
        *) fail "Discovery-Rollenbindung ist ungültig" ;;
    esac
}

prepare_release_and_binding() {
    explicit_root=$1
    explicit_user=$2
    sudo_user=$3
    requested_role=$4
    prefer_launcher_binding=0
    BOUND_TAG=$(resolve_release_tag)
    STAGE_DIR=$(stage_release_contract)
    if [ "${SYNCHRONOUS_STAGE_OWNED:-}" = "1" ]; then
        trap cleanup_synchronous_stage EXIT
    fi
    release_download_required=0
    if [ "$BOUND_ENTRY_MODE" = "regular" ]; then
        if [ -n "${E3DC_BOOTSTRAP_RELEASE_DIR:-}" ]; then
            RELEASE_DIR=$E3DC_BOOTSTRAP_RELEASE_DIR
            if [ "${PREVALIDATED_REGULAR_RELEASE:-0}" != "1" ]; then
                validate_release_checkout \
                    "$RELEASE_DIR" "$BOUND_TAG" \
                    "${E3DC_BOOTSTRAP_EXPECTED_TAG_OBJECT:-}" \
                    "${E3DC_BOOTSTRAP_EXPECTED_SHA:-}"
            fi
        else
            [ -n "${LEGACY_REGULAR_PARENT:-}" ] \
                || LEGACY_REGULAR_PARENT=$(legacy_regular_bootstrap_parent)
            RELEASE_DIR="$LEGACY_REGULAR_PARENT/release"
            release_download_required=1
        fi
    else
        RELEASE_DIR="$STAGE_DIR/release"
        release_download_required=1
    fi
    if [ "$release_download_required" = "1" ]; then
        download_release_checkout "$RELEASE_DIR" "$BOUND_TAG"
        if [ "$BOUND_ENTRY_MODE" = "regular" ]; then
            validate_release_checkout \
                "$RELEASE_DIR" "$BOUND_TAG" \
                "${E3DC_BOOTSTRAP_EXPECTED_TAG_OBJECT:-}" \
                "${E3DC_BOOTSTRAP_EXPECTED_SHA:-}"
        fi
    fi
    BOUND_TAG_OBJECT=$RELEASE_TAG_OBJECT
    BOUND_SHA=$RELEASE_SHA
    discovery="$RELEASE_DIR/$DISCOVERY_RELATIVE"
    if [ -z "$explicit_root" ] \
        && [ "$BOUND_ENTRY_MODE" = "regular" ]; then
        # Kompatibilitätsbrücke für installierte Launcher, die ihren bereits
        # gebundenen Root noch nicht als Argument weiterreichen. Die sichere
        # Root-/Benutzerbindung wird aus dem root-eigenen Launcher gelesen.
        prefer_launcher_binding=1
        SELECTED_EXPLICIT_ROOT=""
    else
        select_console_target "$discovery" "$explicit_root"
    fi
    binding_error=$(mktemp "${STAGE_DIR}/binding-error.XXXXXX") \
        || fail_with_solution \
            "E3DC-UPD-RUN-007" \
            "Die private Fehlerdatei für die Installationsbindung konnte nicht angelegt werden." \
            "Der eigentliche Updater wurde nicht gestartet; Installation und Dienste blieben unverändert." \
            "$STAGE_DIR" \
            "sudo stat -c '%U %G %a %F %n' $STAGE_DIR"
    if ! binding=$(bind_with_discovery \
        "$discovery" \
        "$SELECTED_EXPLICIT_ROOT" "$explicit_user" "$sudo_user" "$requested_role" \
        "$prefer_launcher_binding" \
        2>"$binding_error"); then
        # Die Discovery liefert bereits genau einen typisierten Abbruch samt
        # konkreter Lösung. Diese Ausgabe darf nicht durch einen zweiten,
        # im privaten Web-Updatepfad nicht ausführbaren Befehl verwässert werden.
        cat "$binding_error" >&2
        find "$STAGE_DIR" -depth -delete 2>/dev/null || true
        exit 1
    fi
    rm -f "$binding_error"
    parse_binding "$binding"
}

validate_release_checkout() {
    checkout_dir=$1
    tag=$2
    expected_tag_object=${3:-}
    expected_sha=${4:-}
    canonical_checkout=$(CDPATH= cd -- "$checkout_dir" 2>/dev/null && pwd -P) \
        || fail "Privater Release-Checkout ist nicht erreichbar: $checkout_dir"
    [ "$canonical_checkout" = "$checkout_dir" ] \
        || fail "Privater Release-Checkout ist nicht kanonisch gebunden"
    checkout_parent=${checkout_dir%/release}
    case "$BOUND_ENTRY_MODE:$checkout_parent" in
        regular:/run/e3dc-update-download.*) checkout_suffix=${checkout_parent#/run/e3dc-update-download.} ;;
        rescue:/run/e3dc-update-bootstrap.*) checkout_suffix=${checkout_parent#/run/e3dc-update-bootstrap.} ;;
        *) fail "Release-Checkout liegt nicht im privaten root-Arbeitsbereich" ;;
    esac
    case "$checkout_suffix" in
        ""|*/*) fail "Release-Checkout besitzt keinen eindeutigen privaten Elternpfad" ;;
    esac
    [ ! -L "$checkout_parent" ] && [ ! -L "$checkout_dir" ] \
        || fail "Privater Release-Checkout darf kein Symlink sein"
    parent_metadata=$(stat -c '%u %g %a %F' "$checkout_parent") \
        || fail "Privater Release-Elternpfad ist nicht prüfbar"
    checkout_metadata=$(stat -c '%u %g %a %F' "$checkout_dir") \
        || fail "Privater Release-Checkout ist nicht prüfbar"
    [ "$parent_metadata" = "0 0 700 directory" ] \
        && [ "$checkout_metadata" = "0 0 700 directory" ] \
        || fail "Privater Release-Checkout ist nicht ausschließlich root-zugänglich"
    for required in \
        VERSION e3dc-bootstrap e3dc-update-bootstrap \
        "$DISCOVERY_RELATIVE" Installer/update_simple.py
    do
        [ -f "$checkout_dir/$required" ] && [ ! -L "$checkout_dir/$required" ] \
            || fail "Release-Datei fehlt oder ist kein regulärer Pfad: $required"
    done
    fetched_tag=$(isolated_git -C "$checkout_dir" rev-parse --verify "refs/tags/$tag") \
        || fail "Geladener Release-Tag fehlt im privaten Checkout"
    fetched_sha=$(isolated_git -C "$checkout_dir" rev-parse --verify "refs/tags/$tag^{commit}") \
        || fail "Geladener Release-Commit fehlt im privaten Checkout"
    head_sha=$(isolated_git -C "$checkout_dir" rev-parse --verify HEAD) \
        || fail "Privater Release-Checkout besitzt keinen eindeutigen HEAD"
    [ "${#fetched_tag}" -eq 40 ] && [ "${#fetched_sha}" -eq 40 ] \
        && [ "$head_sha" = "$fetched_sha" ] \
        || fail "Tag, Commit und Checkout sind nicht eindeutig gebunden"
    case "$fetched_tag:$fetched_sha" in
        *[!0-9a-f:]*) fail "Release-Bindung ist nicht hexadezimal" ;;
    esac
    if [ -n "$expected_tag_object$expected_sha" ]; then
        [ -n "$expected_tag_object" ] && [ -n "$expected_sha" ] \
            && [ "$fetched_tag" = "$expected_tag_object" ] \
            && [ "$fetched_sha" = "$expected_sha" ] \
            || fail "Privater Release-Checkout widerspricht der Dispatcher-Bindung"
    fi
    release_version=$(cat "$checkout_dir/VERSION") \
        || fail "VERSION des privaten Release konnte nicht gelesen werden"
    [ -n "$release_version" ] && [ "v$release_version" = "$tag" ] \
        || fail "VERSION, Tag und Commit des privaten Release widersprechen sich"
    if [ "$BOUND_ENTRY_MODE" = "regular" ]; then
        if [ "$0" = "$checkout_dir/e3dc-update-bootstrap" ]; then
            :
        elif [ -n "${LEGACY_REGULAR_PARENT:-}" ] \
            && [ "$0" = "$LEGACY_REGULAR_PARENT/e3dc-update-bootstrap" ] \
            && [ "$checkout_dir" = "$LEGACY_REGULAR_PARENT/release" ]; then
            # Launcher 5.4.4a/b laden nur den commitgebundenen Bootstrap in
            # ihren root-privaten Downloadpfad. Dessen frisch geladener voller
            # Release darf nach obigem exakten Tag-/SHA-Abgleich übernommen
            # werden, ohne einen neuen Parent-Parameter zu verlangen.
            :
        else
            fail "Regular-Modus läuft nicht aus einer gebundenen privaten Releasequelle"
        fi
    fi
    RELEASE_TAG_OBJECT=$fetched_tag
    RELEASE_SHA=$fetched_sha
}

download_release_checkout() {
    checkout_dir=$1
    tag=$2
    mkdir -m 0700 "$checkout_dir" \
        || fail_with_solution \
            "E3DC-UPD-RUN-008" \
            "Das private Checkout-Verzeichnis konnte nicht angelegt werden." \
            "Der gebundene Release wurde nicht ausgecheckt; die Installation wurde nicht verändert." \
            "$checkout_dir" \
            "sudo stat -c '%U %G %a %F %n' $(dirname "$checkout_dir")"
    isolated_git -c init.defaultBranch=main init "$checkout_dir" >/dev/null \
        || fail_with_solution \
            "E3DC-UPD-GIT-002" \
            "Das private temporäre Git-Repository konnte nicht initialisiert werden." \
            "Es wurde kein Release ausgecheckt; die Installation wurde nicht verändert." \
            "$checkout_dir" \
            "sudo stat -c '%U %G %a %F %n' $checkout_dir"
    isolated_git -C "$checkout_dir" remote add origin "$GIT_URL" \
        || fail_with_solution \
            "E3DC-UPD-GIT-003" \
            "Die feste GitHub-Quelle konnte im privaten Checkout nicht gebunden werden." \
            "Es wurde kein Release geladen; die Installation wurde nicht verändert." \
            "$GIT_URL" \
            "curl -I --proto '=https' --tlsv1.2 $REPOSITORY_URL"
    isolated_git -C "$checkout_dir" fetch \
        --no-tags --depth=1 origin \
        "+refs/tags/$tag:refs/tags/$tag" >/dev/null \
        || fail_with_solution \
            "E3DC-UPD-GIT-004" \
            "Der gebundene Release-Tag konnte nicht in den privaten Checkout geladen werden." \
            "Der temporäre Checkout ist unvollständig und wird verworfen; die Installation wurde nicht verändert." \
            "$GIT_URL, Tag $tag" \
            "curl -I --proto '=https' --tlsv1.2 $REPOSITORY_URL/releases/tag/$tag"
    fetched_tag=$(isolated_git -C "$checkout_dir" rev-parse --verify "refs/tags/$tag") \
        || fail_with_solution \
            "E3DC-UPD-GIT-005" \
            "Das geladene Tag-Objekt konnte im privaten Checkout nicht bestätigt werden." \
            "Der temporäre Checkout wird verworfen; die Installation wurde nicht verändert." \
            "Tag $tag" \
            "curl -I --proto '=https' --tlsv1.2 $REPOSITORY_URL/releases/tag/$tag"
    fetched_sha=$(isolated_git -C "$checkout_dir" rev-parse --verify "refs/tags/$tag^{commit}") \
        || fail_with_solution \
            "E3DC-UPD-GIT-006" \
            "Der Commit des geladenen Release-Tags konnte nicht bestätigt werden." \
            "Der temporäre Checkout wird verworfen; die Installation wurde nicht verändert." \
            "Tag $tag" \
            "curl -I --proto '=https' --tlsv1.2 $REPOSITORY_URL/releases/tag/$tag"
    [ "${#fetched_tag}" -eq 40 ] && [ "${#fetched_sha}" -eq 40 ] \
        || fail "Geladener Release-Tag besitzt keine eindeutige Commitbindung"
    case "$fetched_tag:$fetched_sha" in
        *[!0-9a-f:]*) fail "Geladene Release-Bindung ist nicht hexadezimal" ;;
    esac
    isolated_git -C "$checkout_dir" checkout --detach "$fetched_sha" >/dev/null \
        || fail_with_solution \
            "E3DC-UPD-GIT-007" \
            "Der verifizierte Zielcommit konnte nicht als privater Checkout bereitgestellt werden." \
            "Der temporäre Checkout wird verworfen; die Installation wurde nicht verändert." \
            "Commit $fetched_sha" \
            "curl -I --proto '=https' --tlsv1.2 $REPOSITORY_URL/releases/tag/$tag"
    validate_release_checkout "$checkout_dir" "$tag" "$fetched_tag" "$fetched_sha"
}

run_bound_update() (
    checkout="$RELEASE_DIR"
    [ -f "$checkout/e3dc-bootstrap" ] && [ ! -L "$checkout/e3dc-bootstrap" ] \
        || fail "Der bestätigte private Release-Checkout fehlt vor dem Ziel-Updater"
    echo "E3DC-Control Update-Bootstrap"
    echo "  Installation : $BOUND_ROOT"
    echo "  Benutzer     : $BOUND_USER"
    echo "  Rolle        : $BOUND_ROLE"
    echo "  Release      : $BOUND_TAG"
    echo "  Zielcommit   : $BOUND_SHA"
    echo "  Einstieg     : $BOUND_ENTRY_MODE"
    echo "  Alt-Updater  : wird nicht ausgeführt"
    set +e
    env -i \
        PATH=/usr/bin:/bin \
        HOME=/root \
        LANG=C.UTF-8 \
        LC_ALL=C.UTF-8 \
        E3DC_BOOTSTRAP_USER="$BOUND_USER" \
        E3DC_BOOTSTRAP_BOUND_PEER_IP="$BOUND_PEER_IP" \
        E3DC_BOOTSTRAP_ENTRY_MODE="$BOUND_ENTRY_MODE" \
        E3DC_RELEASE_CHECKOUT_VERIFIED=1 \
        /bin/sh "$checkout/e3dc-bootstrap" \
        "$BOUND_ROOT" "$BOUND_TAG" "$BOUND_SHA" "$BOUND_ROLE"
    result=$?
    set -e
    return "$result"
)

print_job_commands() {
    printf 'Status: systemctl status --no-pager %s\n' "$UNIT"
    printf 'Protokoll: journalctl -fu %s\n' "$UNIT"
    printf 'Dateilog: tail -f %s\n' "$LOG_FILE"
}

update_job_running() {
    active_state=$(systemctl show "$UNIT" --property=ActiveState --value 2>/dev/null || true)
    case "$active_state" in
        active|activating|reloading) return 0 ;;
    esac
    systemctl --quiet is-active "$UNIT"
}

start_background_job() {
    explicit_root=${1:-}
    requested_role=${2:-auto}
    [ "$#" -le 2 ] || fail_with_solution \
        "E3DC-UPD-CALL-001" \
            "Der Hintergrundstart hat zu viele Argumente erhalten." \
            "Es wurde kein Updateauftrag angenommen und nichts am System verändert." \
            "Aufruf des Update-Bootstrap" \
            "sudo /bin/sh ./e3dc-update-bootstrap" \
        64
    BOUND_ENTRY_MODE=rescue
    prepare_job_paths
    prepare_lock_file "$START_LOCK_FILE"
    exec 8>"$START_LOCK_FILE"
    flock 8 \
        || fail_with_solution \
            "E3DC-UPD-BUSY-003" \
            "Die Start-Sperre des Updates konnte nicht übernommen werden." \
            "Es wurde kein zweiter Updateauftrag gestartet." \
            "$START_LOCK_FILE" \
            "sudo systemctl status --no-pager $UNIT"
    if update_job_running; then
        printf '\n[HINWEIS] E3DC-UPD-BUSY-001\n'
        printf 'Was ist passiert: Ein Update-Systemjob läuft bereits; es wird kein zweiter gestartet.\n'
        printf 'Systemzustand: Der vorhandene Updatejob arbeitet unverändert weiter.\n'
        printf 'Ziel: %s\n' "$UNIT"
        printf 'Lösung: Führe genau diesen sicheren Befehl aus:\n  sudo systemctl status --no-pager %s\n' "$UNIT"
        return 0
    fi
    SYNCHRONOUS_STAGE_OWNED=0
    prepare_release_and_binding \
        "$explicit_root" "" "${SUDO_USER:-}" "$requested_role"
    prepare_log
    write_runtime_value "$STATUS_FILE" "launching"
    rm -f "$PID_FILE"
    systemctl reset-failed "$UNIT" 2>/dev/null || true
    launch_output=""
    set +e
    launch_output=$(systemd-run \
        --unit="${UNIT%.service}" \
        --collect \
        --no-block \
        --property=Type=exec \
        --property=User=root \
        --property=Group=root \
        --property=WorkingDirectory=/ \
        --property=UMask=0077 \
        --property=TimeoutStartSec=infinity \
        --setenv=E3DC_BOOTSTRAP_BACKGROUND_WORKER=1 \
        --setenv="E3DC_BOOTSTRAP_STAGE_DIR=$STAGE_DIR" \
        --setenv="E3DC_BOOTSTRAP_TAG=$BOUND_TAG" \
        --setenv="E3DC_BOOTSTRAP_TAG_OBJECT=$BOUND_TAG_OBJECT" \
        --setenv="E3DC_BOOTSTRAP_SHA=$BOUND_SHA" \
        --setenv="E3DC_INSTALL_PATH=$BOUND_ROOT" \
        --setenv="E3DC_BOOTSTRAP_USER=$BOUND_USER" \
        --setenv="E3DC_BOOTSTRAP_BOUND_ROLE=$BOUND_ROLE" \
        --setenv="E3DC_BOOTSTRAP_BOUND_PEER_IP=$BOUND_PEER_IP" \
        --setenv=SUDO_USER= \
        /bin/sh "$STAGE_DIR/release/e3dc-update-bootstrap" --systemd-worker 2>&1)
    launch_status=$?
    set -e
    if [ "$launch_status" -ne 0 ]; then
        find "$STAGE_DIR" -depth -delete 2>/dev/null || true
        write_runtime_value "$STATUS_FILE" "$launch_status"
        printf '[!] Rettungsupdate-Systemjob konnte nicht gestartet werden (Exit %s).\n%s\n' \
            "$launch_status" "$launch_output" >>"$LOG_FILE"
        fail_with_solution \
            "E3DC-UPD-SYSTEMD-001" \
            "Der vorbereitete Update-Systemjob konnte nicht gestartet werden (Exit $launch_status)." \
            "Der eigentliche Ziel-Updater lief nicht an; Installation und Dienste wurden durch diesen Auftrag nicht verändert." \
            "$UNIT" \
            "sudo journalctl -u $UNIT --no-pager -n 120"
    fi
    [ -z "$launch_output" ] || printf '%s\n' "$launch_output"
    printf 'Installation: %s (Benutzer %s, Rolle %s)\n' \
        "$BOUND_ROOT" "$BOUND_USER" "$BOUND_ROLE"
    printf 'Update gestartet: %s\n' "$UNIT"
    print_job_commands
}

validate_worker_environment() {
    [ "${E3DC_BOOTSTRAP_BACKGROUND_WORKER:-}" = "1" ] \
        && [ -n "${INVOCATION_ID:-}" ] \
        || fail "Hintergrund-Worker besitzt keinen systemd-Ausführungsvertrag"
    [ -z "${SUDO_USER:-}" ] || fail "Hintergrund-Worker übernimmt keinen sudo-Aufrufer"
    STAGE_DIR=${E3DC_BOOTSTRAP_STAGE_DIR:-}
    case "$STAGE_DIR" in
        /run/e3dc-update-bootstrap.*) ;;
        *) fail "Hintergrund-Worker besitzt keinen privaten Bootstrap-Pfad" ;;
    esac
    RELEASE_DIR="$STAGE_DIR/release"
    [ "$0" = "$RELEASE_DIR/e3dc-update-bootstrap" ] \
        || fail "Hintergrund-Worker läuft nicht aus dem privaten Zielrelease"
    [ -f "$0" ] && [ ! -L "$0" ] \
        || fail "Hintergrund-Worker ist keine reguläre Releasedatei"
    BOUND_TAG=${E3DC_BOOTSTRAP_TAG:-}
    BOUND_TAG_OBJECT=${E3DC_BOOTSTRAP_TAG_OBJECT:-}
    BOUND_SHA=${E3DC_BOOTSTRAP_SHA:-}
    BOUND_ROOT=${E3DC_INSTALL_PATH:-}
    BOUND_USER=${E3DC_BOOTSTRAP_USER:-}
    BOUND_ROLE=${E3DC_BOOTSTRAP_BOUND_ROLE:-}
    BOUND_PEER_IP=${E3DC_BOOTSTRAP_BOUND_PEER_IP:-}
    [ "${#BOUND_TAG_OBJECT}" -eq 40 ] && [ "${#BOUND_SHA}" -eq 40 ] \
        || fail "Hintergrund-Worker besitzt keine vollständige Release-SHA-Bindung"
    case "$BOUND_TAG_OBJECT:$BOUND_SHA" in
        *[!0-9a-f:]*) fail "Hintergrund-Worker besitzt ungültige Release-SHAs" ;;
    esac
    validate_release_checkout \
        "$RELEASE_DIR" "$BOUND_TAG" "$BOUND_TAG_OBJECT" "$BOUND_SHA"
    case "$BOUND_ROLE" in
        off|master|slave|shadow) ;;
        *) fail "Hintergrund-Worker besitzt keine gültige Rollenbindung" ;;
    esac
}

run_background_worker() {
    BOUND_ENTRY_MODE=rescue
    validate_worker_environment
    prepare_job_paths
    prepare_lock_file "$LOCK_FILE"
    exec 9>"$LOCK_FILE"
    flock -n 9 \
        || fail_with_solution \
            "E3DC-UPD-BUSY-002" \
            "Die exklusive Update-Sperre ist bereits belegt." \
            "Der zweite Worker beendet sich; der vorhandene Updatevorgang bleibt alleiniger Entscheider." \
            "$LOCK_FILE" \
            "sudo systemctl status --no-pager $UNIT" \
            75
    cleanup_worker() {
        exit_code=$?
        trap - EXIT
        set +e
        rm -f "$PID_FILE"
        find "$STAGE_DIR" -depth -delete 2>/dev/null || true
        write_runtime_value "$STATUS_FILE" "$exit_code"
        exit "$exit_code"
    }
    trap cleanup_worker EXIT
    exec >>"$LOG_FILE" 2>&1
    write_runtime_value "$PID_FILE" "$$"
    write_runtime_value "$STATUS_FILE" "running"
    printf '[OK] Installation, Benutzer und Rolle sind zentral gebunden.\n'
    set +e
    run_bound_update
    result=$?
    set -e
    if [ "$result" -eq 0 ]; then
        printf '[OK] Rettungsupdate abgeschlossen.\n'
    else
        printf '[!] Rettungsupdate fehlgeschlagen (Exit %s).\n' "$result"
    fi
    return "$result"
}

run_synchronous_update() {
    explicit_root=${1:-}
    requested_role=${2:-auto}
    [ "$#" -le 2 ] || fail_with_solution \
        "E3DC-UPD-CALL-002" \
            "Der synchrone Bootstrap-Aufruf hat zu viele Argumente erhalten." \
            "Es wurde kein Updateauftrag angenommen und nichts am System verändert." \
            "Aufruf des Update-Bootstrap" \
            "sudo /bin/sh ./e3dc-update-bootstrap" \
        64
    bind_entry_mode
    prepare_job_paths
    if [ "${E3DC_BOOTSTRAP_LOCK_HELD:-}" != "1" ]; then
        prepare_lock_file "$START_LOCK_FILE"
        exec 8>"$START_LOCK_FILE"
        flock 8 \
            || fail_with_solution \
                "E3DC-UPD-BUSY-003" \
                "Die Start-Sperre des Updates konnte nicht übernommen werden." \
                "Es wurde kein zweiter Updateauftrag gestartet." \
                "$START_LOCK_FILE" \
                "sudo systemctl status --no-pager $UNIT"
        if update_job_running; then
            fail_with_solution \
                "E3DC-UPD-BUSY-001" \
                "Ein Update-Systemjob läuft bereits." \
                "Der synchrone Zweitaufruf beendet sich; der vorhandene Updatejob arbeitet unverändert weiter." \
                "$UNIT" \
                "sudo systemctl status --no-pager $UNIT" \
                75
        fi
        prepare_lock_file "$LOCK_FILE"
        exec 9>"$LOCK_FILE"
        flock -n 9 \
            || fail_with_solution \
                "E3DC-UPD-BUSY-002" \
                "Die exklusive Update-Sperre ist bereits belegt." \
                "Der synchrone Zweitaufruf beendet sich; der vorhandene Updatevorgang bleibt alleiniger Entscheider." \
                "$LOCK_FILE" \
                "sudo systemctl status --no-pager $UNIT" \
                75
        flock -u 8 \
            || fail_with_solution \
                "E3DC-UPD-BUSY-004" \
                "Die Start-Sperre konnte nach Übernahme der exklusiven Update-Sperre nicht freigegeben werden." \
                "Der Ziel-Updater wurde noch nicht gestartet; dieser Aufruf beendet sich vorsorglich." \
                "$START_LOCK_FILE" \
                "sudo systemctl status --no-pager $UNIT"
    fi
    SYNCHRONOUS_STAGE_OWNED=1
    prepare_release_and_binding \
        "$explicit_root" "${E3DC_BOOTSTRAP_USER:-}" "${SUDO_USER:-}" "$requested_role"
    set +e
    run_bound_update
    result=$?
    set -e
    find "$STAGE_DIR" -depth -delete 2>/dev/null || true
    trap - EXIT
    return "$result"
}

command -v id >/dev/null 2>&1 \
    || fail_with_solution \
        "E3DC-UPD-DEP-001" \
        "Das benötigte Programm 'id' fehlt." \
        "Das Update wurde vor Download, Backup und Dienständerungen beendet." \
        "Systempaket coreutils" \
        "sudo apt-get install -y coreutils"
[ "$(id -u)" -eq 0 ] || fail "Rettungsupdate bitte mit sudo starten"
require_commands

if [ "${1:-}" = "--systemd-worker" ]; then
    shift
    [ "$#" -eq 0 ] || fail_with_solution \
        "E3DC-UPD-CALL-003" \
        "Der interne Hintergrund-Worker erhielt unerwartete Argumente." \
        "Der Worker wurde vor dem Ziel-Updater beendet; die Installation wurde durch ihn nicht verändert." \
        "$UNIT" \
        "sudo journalctl -u $UNIT --no-pager -n 120" \
        64
    run_background_worker
elif [ "${E3DC_BOOTSTRAP_ENTRY_MODE:-}" != "regular" ] \
    && [ "${E3DC_BOOTSTRAP_INLINE_WORKER:-}" != "1" ]; then
    start_background_job "$@"
else
    run_synchronous_update "$@"
fi
